# OpenDota API key (optional but recommended for higher rate limits)
OPENDOTA_KEY=

# Optional: where to sync `data/processed/` + `data/metrics/` via rsync over SSH
# Example: user@your-vps:/srv/dota-datas
DOTA_DATA_REMOTE=

# Optional (recommended): force a specific SSH private key (path can be relative to the repo root)
# Example:
#   DOTA_DATA_SSH_IDENTITY=secrets/id_ed25519
#   DOTA_DATA_SSH_KNOWN_HOSTS=secrets/known_hosts
#   DOTA_DATA_SSH_STRICT_HOST_KEY_CHECKING=accept-new
DOTA_DATA_SSH_IDENTITY=
DOTA_DATA_SSH_KNOWN_HOSTS=
DOTA_DATA_SSH_STRICT_HOST_KEY_CHECKING=
# DOTA_DATA_SSH_PORT=22

# Optional (recommended): JSON config file for items to sync.
# Supports either:
#  - an object mapping: {"processed":"data/processed","metrics":"data/metrics",...}
#  - an array: [{"key":"processed","path":"data/processed"}, ...]
# Path can be relative to the repo root.
DOTA_DATA_SYNC_CONFIG=

# Optional: force a short temp directory (helps on Windows/WSL if you hit
# "unix path too long for unix domain socket" when running Streamlit).
# Examples:
# - Windows: C:\Temp
# - WSL/Linux: /tmp
DOTA_DATA_TMPDIR=

# Optional (not recommended): SSH password for non-interactive rsync/ssh via sshpass.
# If set, the sync script will use `sshpass -e` and you won't be prompted.
# Security note: prefer SSH keys instead of storing passwords on disk.
DOTA_DATA_SSH_PASSWORD=
